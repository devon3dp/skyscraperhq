.HIGH{color:var(--off);border-color:var(--off)}.MED{color:var(--stale);border-color:var(--stale)}.LOW{color:var(--wait)}.OK{color:var(--live);border-color:var(--live)}
.NEEDS{color:var(--gold);border-color:var(--gold)}
