extends Node3D

const FLOOR_COUNT := 53
const WORKERS_TOTAL := 2191
const LIFTS_TOTAL := 9

var camera: Camera3D
var orbit_angle := 0.0
var zoom := 70.0
var selected_floor := 55
var floor_nodes := {}
var hud_label: RichTextLabel

func _ready() -> void:
	DisplayServer.window_set_title("QSB Godot Native Cockpit — Real 3D Skyscraper")
	_build_world()
	_build_tower()
	_build_lifts()
	_build_openclaw()
	_build_hud()
	_update_hud()

func _process(delta: float) -> void:
	orbit_angle += delta * 0.08
	if camera:
		var x := sin(orbit_angle) * zoom
		var z := cos(orbit_angle) * zoom
		camera.position = Vector3(x, 28, z)
		camera.look_at(Vector3(0, 12, 0), Vector3.UP)

func _unhandled_input(event: InputEvent) -> void:
	if event is InputEventMouseButton:
		if event.button_index == MOUSE_BUTTON_WHEEL_UP and event.pressed:
			zoom = max(25.0, zoom - 4.0)
		elif event.button_index == MOUSE_BUTTON_WHEEL_DOWN and event.pressed:
			zoom = min(120.0, zoom + 4.0)

	if event is InputEventKey and event.pressed:
		if event.keycode == KEY_UP:
			selected_floor = min(55, selected_floor + 1)
			_update_hud()
			_highlight_floor()
		elif event.keycode == KEY_DOWN:
			selected_floor = max(1, selected_floor - 1)
			_update_hud()
			_highlight_floor()
		elif event.keycode == KEY_1:
			selected_floor = 41
			_update_hud()
			_highlight_floor()
		elif event.keycode == KEY_2:
			selected_floor = 42
			_update_hud()
			_highlight_floor()
		elif event.keycode == KEY_3:
			selected_floor = 55
			_update_hud()
			_highlight_floor()

func _build_world() -> void:
	var env := WorldEnvironment.new()
	var environment := Environment.new()
	environment.background_mode = Environment.BG_COLOR
	environment.background_color = Color(0.01, 0.015, 0.03)
	environment.ambient_light_source = Environment.AMBIENT_SOURCE_COLOR
	environment.ambient_light_color = Color(0.25, 0.35, 0.55)
	environment.ambient_light_energy = 0.9
	env.environment = environment
	add_child(env)

	camera = Camera3D.new()
	camera.name = "QSB Orbit Camera"
	camera.fov = 55
	camera.current = true
	add_child(camera)

	var sun := DirectionalLight3D.new()
	sun.name = "Tower Key Light"
	sun.rotation_degrees = Vector3(-55, -35, 0)
	sun.light_energy = 2.2
	add_child(sun)

	var fill := OmniLight3D.new()
	fill.name = "Neon Fill Light"
	fill.position = Vector3(20, 20, 25)
	fill.light_energy = 3.0
	fill.omni_range = 90
	add_child(fill)

func _build_tower() -> void:
	for i in range(1, FLOOR_COUNT + 1):
		var y := float(i) * 0.42
		var color := _floor_color(i)
		var floor := _box("F%02d" % i, Vector3(0, y, 0), Vector3(9.5, 0.16, 4.2), color)
		floor_nodes[i] = floor
		add_child(floor)

		if i % 3 == 0 or i in [1, 7, 11, 22, 30, 35, 41, 42, 43, 44, 45, 53]:
			var label := Label3D.new()
			label.text = "F%d" % i
			label.position = Vector3(-6.5, y, 0)
			label.billboard = BaseMaterial3D.BILLBOARD_ENABLED
			label.modulate = Color(0.65, 0.95, 1.0)
			label.font_size = 18
			add_child(label)

	var penthouse := _box("Penthouse Crown", Vector3(0, 23.5, 0), Vector3(11.5, 1.1, 5.3), Color(1.0, 0.78, 0.25))
	add_child(penthouse)

	var title := Label3D.new()
	title.text = "QSB PROFESSIONAL 3D SKYSCRAPER"
	title.position = Vector3(0, 25.2, 0)
	title.billboard = BaseMaterial3D.BILLBOARD_ENABLED
	title.modulate = Color(0.0, 1.0, 1.0)
	title.font_size = 34
	add_child(title)

	_highlight_floor()

func _build_lifts() -> void:
	for i in range(LIFTS_TOTAL):
		var x := 6.2 + float(i) * 0.55
		var shaft := _box("Lift Shaft %d" % (i + 1), Vector3(x, 12.0, -2.8), Vector3(0.08, 22.0, 0.08), Color(0.08, 0.22, 0.38, 0.65))
		add_child(shaft)

		var car_y := 1.4 + float((i * 6) % 52) * 0.42
		var car := _box("Lift Car %d" % (i + 1), Vector3(x, car_y, -2.8), Vector3(0.32, 0.32, 0.32), Color(0.1, 0.85, 1.0))
		add_child(car)

func _build_openclaw() -> void:
	var sphere := MeshInstance3D.new()
	var mesh := SphereMesh.new()
	mesh.radius = 0.45
	mesh.height = 0.9
	sphere.mesh = mesh
	sphere.name = "OpenClaw Supervisor"
	sphere.position = Vector3(7.8, 18.5, 1.5)
	var mat := StandardMaterial3D.new()
	mat.albedo_color = Color(0.75, 0.25, 1.0)
	mat.emission_enabled = true
	mat.emission = Color(0.6, 0.1, 1.0)
	mat.emission_energy_multiplier = 1.8
	sphere.material_override = mat
	add_child(sphere)

	var label := Label3D.new()
	label.text = "OpenClaw F45 · 3 tickets"
	label.position = Vector3(9.3, 18.5, 1.5)
	label.billboard = BaseMaterial3D.BILLBOARD_ENABLED
	label.modulate = Color(0.9, 0.55, 1.0)
	label.font_size = 20
	add_child(label)

func _build_hud() -> void:
	var canvas := CanvasLayer.new()
	add_child(canvas)

	var panel := PanelContainer.new()
	panel.position = Vector2(18, 18)
	panel.custom_minimum_size = Vector2(520, 360)
	canvas.add_child(panel)

	hud_label = RichTextLabel.new()
	hud_label.bbcode_enabled = true
	hud_label.fit_content = true
	hud_label.custom_minimum_size = Vector2(500, 340)
	panel.add_child(hud_label)

	var help := Label.new()
	help.text = "Controls: Mouse wheel zoom · UP/DOWN floors · 1=OANDA F41 · 2=Binance F42 · 3=Penthouse"
	help.position = Vector2(18, 392)
	help.add_theme_color_override("font_color", Color(0.4, 1.0, 1.0))
	canvas.add_child(help)

func _update_hud() -> void:
	if hud_label == null:
		return

	hud_label.text = ""
	hud_label.append_text("[color=cyan][b]QSB GODOT NATIVE COCKPIT[/b][/color]\n")
	hud_label.append_text("[color=yellow]Professional 3D skyscraper prototype[/color]\n\n")
	hud_label.append_text("[b]Verified tower state[/b]\n")
	hud_label.append_text("Floors: 53 + Roof + Penthouse anchor\n")
	hud_label.append_text("Workers: [color=lime]%d[/color]\n" % WORKERS_TOTAL)
	hud_label.append_text("Lifts: [color=cyan]%d[/color]\n" % LIFTS_TOTAL)
	hud_label.append_text("Selected floor: [color=yellow]F%d[/color]\n" % selected_floor)
	hud_label.append_text("OpenClaw: visible, supervisory only\n\n")
	hud_label.append_text("[b]Safety locks[/b]\n")
	hud_label.append_text("[color=red]Real-money trading: OFF[/color]\n")
	hud_label.append_text("[color=red]Listings publish: OFF[/color]\n")
	hud_label.append_text("[color=red]Payments/spend: OFF[/color]\n")
	hud_label.append_text("[color=red]OpenClaw execution: OFF[/color]\n\n")
	hud_label.append_text("[b]Target panels[/b]\n")
	hud_label.append_text("Penthouse · OANDA F41 · Binance F42 · Commerce · Hardware · Security\n")

func _highlight_floor() -> void:
	for i in floor_nodes.keys():
		var node: MeshInstance3D = floor_nodes[i]
		var mat := StandardMaterial3D.new()
		if i == selected_floor:
			mat.albedo_color = Color(1.0, 0.9, 0.2)
			mat.emission_enabled = true
			mat.emission = Color(1.0, 0.75, 0.1)
			mat.emission_energy_multiplier = 1.4
		else:
			mat.albedo_color = _floor_color(i)
		node.material_override = mat

func _floor_color(floor: int) -> Color:
	if floor in [41, 42, 43]:
		return Color(0.1, 0.45, 1.0)
	if floor in [44]:
		return Color(0.25, 0.9, 0.45)
	if floor in [30, 31]:
		return Color(0.95, 0.25, 0.25)
	if floor in [35]:
		return Color(0.95, 0.75, 0.2)
	if floor in [6, 8, 9, 10, 11, 12, 13, 14]:
		return Color(0.8, 0.25, 0.95)
	if floor in [45]:
		return Color(0.25, 0.95, 0.75)
	if floor in [22]:
		return Color(0.0, 0.85, 1.0)
	if floor in [53]:
		return Color(1.0, 0.7, 0.25)
	return Color(0.18, 0.32, 0.48)

func _box(name: String, pos: Vector3, scale: Vector3, color: Color) -> MeshInstance3D:
	var box := BoxMesh.new()
	var mi := MeshInstance3D.new()
	mi.name = name
	mi.mesh = box
	mi.position = pos
	mi.scale = scale

	var mat := StandardMaterial3D.new()
	mat.albedo_color = color
	mat.metallic = 0.15
	mat.roughness = 0.32
	mi.material_override = mat

	return mi
