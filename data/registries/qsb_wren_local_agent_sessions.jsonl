 top: 50%; transform: translateY(-50%); width: 4px; height: 20px; border-radius: 2px; box-shadow: 0 0 8px currentColor; }\n  .member span { flex: 1; display: flex; align-items: center; gap: 6px; }\n\n  /* sessions */\n  .session-list { max-height: 340px; overflow-y: auto; padding-right: 2px; font-size: 9.5px; }\n  .session-item { background: rgba(18,30,67,0.4); border-radius: 6px; margin-bottom: 6px; padding: 8px 10px; display: flex; justify-content: space-between; align-items: center; gap: 8px; }\n  .session-item:hover { background: rgba(25,39,74,0.6); }\n\n  /* floors */\n  .floor-list { max-height: 280px; overflow-y: auto; padding-right: 2px; font-size: 10px; }\n  .floor-item { background: rgba(15,23,42,0.6); border-radius: 6px; margin-bottom: 6px; padding: 8px 10px; display: flex; justify-content: space-between; align-items: center; gap: 8px; }\n\n  /* f47 */\n  .f47-list { max-height: 200px; overflow-y: auto; font-size: 9.5px; padding-right: 2px; }\n  .stamp-item { background: rgba(18,30,67,0.4); border-radius: 6px; margin-bottom: 4px; padding: 6px 8px; display: flex; justify-content: space-between; align-items: center; gap: 6px; }\n\n  /* memory */\n  .memory-list { max-height: 200px; overflow-y: auto; font-size: 9.5px; padding-right: 2px; }\n  .pulse-item { background: rgba(18,30,67,0.4); border-radius: 6px; margin-bottom: 4px; padding: 6px 8px; display: flex; justify-content: space-between; align-items: center; gap: 6px; }\n\n  /* footer */\n  .footer { text-align: center; font-size: 9px; color: var(--dim); margin-top: 12px; padding-bottom: 8px; border-top: 1px solid var(--line); }\n\n  @keyframes blip { 0%,100%{opacity:.3;}50%{opacity:1;} }\n</style>\n<script>\nconst data = JSON.parse('/* WREN_DATA_PLACEHOLDER */');\ndocument.title = \"Wren \u00b7 Bench\";\nfunction render() {\n    const d = data;\n\n    // AVATAR tile\n    document.querySelector(\".t-avatar .wrench\").innerHTML = `\n      <div class=\"wrench-stage\">\n        <svg viewBox=\"0 0 24 24\" width=\"160\" height=\"160\" style=\"position:absolute;\">\n          <circle cx=\"12\" cy=\"12\" r=\"8\" fill=\"${d.traits?.strength || '#3b82f6'}\"/>\n        </svg>\n      </div>`;\n\n    // IDENTITY tile  \n    const id = d.identity || {};\n    document.querySelector(\".t-identity\").innerHTML = `\n      <h2><span class=\"accent\">Identity</span></h2>\n      <div style=\"font-size:10px;color:${id.role||'var(--dim)'}\">${id.name||\"\"}</div>`;\n\n    // TRAITS tile\n    const traits = d.traits || {};\n    document.querySelector(\".t-traits\").innerHTML = `\n      <h2><span class=\"accent\">Traits</span></h2>\n      ${Object.entries(traits).map(([k,v]) => `<div class=\"trait-row\"><span class=\"lbl\">${k}</span><div class=\"track\"><div class=\"fill\" style=\"width:${Math.min(v*100,100)}%\"></div></div><span class=\"val\">${v.toFixed(2)}</span></div>`).join(\"\")}`;\n\n    // TOOLBELT tile\n    const tools = d.toolbelt || {};\n    document.querySelector(\".t-toolbelt\").innerHTML = `\n      <h2><span class=\"accent\">Toolbelt</span> (${Object.keys(tools||{}).length})</h2>\n      ${Object.entries(tools||{}).map(([k,v]) => `<div style=\"font-size:9px;margin-bottom:4px;color:${v?'var(--text)':'var(--dim)'}\">${k}${v?` \u00b7 active`:``}</div>`).join(\"\")}`;\n\n    // SAID tile\n    const last = d.last_final_text || {};\n    document.querySelector(\".t-said\").innerHTML = `\n      <h2><span class=\"accent\">Last Said</span></h2>\n      ${last.text ? `<pre style=\"font-size:9px;margin-top:6px;white-space:normal;line-height:1.4\">${escapeHtml(last.text)}</pre>` : \"<div style='color:var(--dim)'>\u2026waiting for output</div>\"}`;\n\n    // COUNCIL tile\n    document.querySelector(\".t-council\").innerHTML = `\n      <h2><span class=\"accent\">Council</span></h2>\n      ${d.council?.map(m => `<div class=\"member\" style=\"--hue:${m.hue}\"><span>${escapeHtml(`<strong>${m.label}</strong>`)} \u00b7 ${escapeHtml(`\u2022 ${m.role}`)}</span></div>`).join(\"\") || \"\"}`;\n\n    // SESSIONS tile\n    const sess = d.sessions || {};\n    document.querySelector(\".t-sessions\").innerHTML = `\n      <h2><span class=\"accent\">Sessions</span> (${sess.count_total_est||0})</h2>\n      ${sess.avg_wall_s ? `<div style='font-size:9px;margin-bottom:6px'>Avg wall time: ${sess.avg_wall_s}s</div>` : \"\"}\n      <div class=\"session-list\">${(d.recent || []).map(r => `\n        <div class=\"session-item\">\n          <span>${escapeHtml(`<strong>Session #${r.sid}</strong> \u00b7 Model: ${escapeHtml(r.model)}</strong></span>`)}`) + (sess.avg_tool_calls ? `<span style='color:${parseInt(sess.avg_wall_s||0)>3?'var(--warn)':'var(--ok)'}'>Tools: ${Math.round(sess.avg_tool_calls)}</span>`:\"\")}</div>`).join(\"\") || \"\"}\n      `;\n\n    // FLOORS tile  \n    document.querySelector(\".t-floors\").innerHTML = `\n      <h2><span class=\"accent\">Floor Cards</span> (Today)</h2>\n      ${d.floor_cards_today?.map(f => `<div class=\"floor-item\"><strong>${escapeHtml(`\u2022 Floor: ${f.floor}`)}</strong></div>`).join(\"\") || \"\"}\n    `;\n\n    // F47 tile  \n    document.querySelector(\".t-f47\").innerHTML = `\n      <h2><span class=\"accent\">F47 Stamps</span> (Recent)</h2>\n      ${d.f47?.map(s => `<div class=\"stamp-item\"><strong>${escapeHtml(`\u2022 ${s.kind}</strong></div>`).join(\"\") || \"\"}\n    `;\n\n    // MEMORY tile  \n    document.querySelector(\".t-memory\").innerHTML = `\n      <h2><span class=\"accent\">Memory Pulses</span> (Wren mentions)</h2>\n      ${d.memory_pulses?.map(p => `<div class=\"pulse-item\"><strong>${escapeHtml(`\u2022 ${p.name}</strong></div>`).join(\"\") || \"\"}\n    `;\n\n    // GPU tile  \n    const gpu = d.gpu || {};\n    document.querySelector(\".t-floors\").innerHTML += `\n      <h2><span class=\"accent\">GPU State</span></h2>\n      ${gpu.power_w ? `<div style='font-size:9px;margin-bottom:4px'>Power: ${Math.round(gpu.power_w)}W \u00b7 Temp: ${gpu.temp_c}\u00b0C</div>` : \"\"}`;\n\n    // OLLAMA tile  \n    const ollama = d.ollama || [];\n    document.querySelector(\".t-floors\").innerHTML += `\n      <h2><span class=\"accent\">Ollama Models</span></h2>\n      ${ollama.map(m => `<div style='font-size:9px;margin-bottom:4px'>${escapeHtml(`\u2022 ${m.name}</strong>)`)</div>`).join(\"\") || \"\"}\n    `;\n\n    // FOOTER  \n    document.querySelector(\".footer\").innerHTML = `${d.ts||\"\"}`;\n  }\nfunction escapeHtml(s){return s.replace(/&/g,\"&amp;\").replace(/</g,\"&lt;\").replace(/>/g,\"&gt;\");}\nrender();\n</script>\n</body></html>`\n\n```"}
