h.join(root, file)\n            dst_file = os.path.join(snapshot_dir, os.path.relpath(src_file, sandbox_path))\n            os.makedirs(os.path.dirname(dst_file), exist_ok=True)\n            shutil.copy2(src_file, dst_file)\n\ndef cleanup_stale_sandboxes():\n    cutoff_date = datetime.now() - timedelta(days=7)  # Cleanup files older than 7 days\n    for root, dirs, _ in os.walk(SANDBOX_ROOT):\n        for dir_name in dirs:\n            sandbox_path = os.path.join(root, dir_name)\n            if os.path.getmtime(sandbox_path) < cutoff_date.timestamp():\n                shutil.rmtree(sandbox_path)\n\n# Example usage\ncreate_snapshot('/vaults/nvme0/qsb_tower_v1/data/team_sandbox/candidate_123')\ncleanup_stale_sandboxes()\n```\n\nThis approach enhances the reliability and maintainability of our sandbox system by providing version control and automated cleanup."}
