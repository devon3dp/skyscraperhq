  "upgrades": [
    {
      "id": "glow_bloom",
      "title": "Glow / Bloom",
      "proposed_by": "openai",
      "wren_verdict": "accepted_with_correction",
      "correction": "OpenAI wrote Environment.bloom_*; in Godot 4.6 it's Environment.glow_*",
      "godot_46_api": {
        "Environment.glow_enabled": true,
        "Environment.glow_intensity": 0.8,
        "Environment.glow_strength": 1.2,
        "Environment.glow_bloom": 0.1,
        "Environment.glow_hdr_threshold": 1.0
      },
      "visual": "Bright emission surfaces (amber dais F47, F55 orb, F48 bubbles) bloom softly into the room",
      "perf": "low_med",
      "apply_at": "TowerRenderer._make_env"
    },
    {
      "id": "ssao",
      "title": "Screen-Space Ambient Occlusion",
      "proposed_by": "deepseek",
      "wren_verdict": "accepted",
      "godot_46_api": {
        "Environment.ssao_enabled": true,
        "Environment.ssao_radius": 1.5,
        "Environment.ssao_intensity": 1.5,
        "Environment.ssao_power": 1.5
      },
      "visual": "Contact shadows in corners + under desks make interiors feel materially real",
      "perf": "med",
      "apply_at": "TowerRenderer._make_env"
    },
    {
      "id": "ssil",
      "title": "Screen-Space Indirect Lighting",
      "proposed_by": "wren",
      "wren_verdict": "accepted",
      "godot_46_api": {
        "Environment.ssil_enabled": true,
        "Environment.ssil_radius": 5.0,
        "Environment.ssil_intensity": 1.2
      },
      "visual": "Amber dais bounces warm light onto the violet lamp surround on F47",
      "perf": "med",
      "apply_at": "TowerRenderer._make_env"
    },
    {
      "id": "sdfgi",
      "title": "SDFGI dynamic global illumination",
      "proposed_by": "wren_corrected_from_openai_bakedlightmap",
      "wren_verdict": "accepted",
      "correction": "OpenAI proposed BakedLightmapGI; in Godot 4.6 the class is LightmapGI (baked) OR SDFGI (dynamic). For a tall procedural tower, SDFGI is the right call \u2014 no bake step.",
      "godot_46_api": {
        "Environment.sdfgi_enabled": true,
        "Environment.sdfgi_cascades": 4,
        "Environment.sdfgi_min_cell_size": 0.4,
        "Environment.sdfgi_use_occlusion": true
      },
      "visual": "Floors illuminate each other; lift lights spill into adjacent floors",
      "perf": "high",
      "apply_at": "TowerRenderer._make_env"
    },
    {
      "id": "tonemap_aces",
      "title": "ACES tonemap with exposure",
      "proposed_by": "wren",
      "wren_verdict": "accepted",
      "godot_46_api": {
        "Environment.tonemap_mode": "TONE_MAPPER_ACES",
        "Environment.tonemap_exposure": 1.1,
        "Environment.tonemap_white": 6.0
      },
      "visual": "More cinematic highlight rolloff than Filmic; emission preserves color into bright areas",
      "perf": "low",
      "apply_at": "TowerRenderer._make_env"
    },
    {
      "id": "volumetric_fog",
      "title": "Volumetric fog",
      "proposed_by": "openai",
