 recognition.start();\n\n    // Expose stopWakeListener function \n    this.stopWakeListener = function() {\n        recognition.stop();\n    };\n}\n\n// Helper function to show small toast\nfunction showSmallToast(message) {\n    // Code to show a small toast with the given message\n    console.log(`Showing small toast: ${message}`);\n}", "wall_s": 5.48, "ts": "2026-07-03T08:57:10Z"}
