# ---------- the broker: opens the cage for ONE approved chat ----------
def _sudo():
    try:
        return VAULT_SUDO.read_text().strip().split("=")[-1].strip()
    except Exception:
        return ""


def build_packet(jid, question):
    """Compose the approved cage packet with the identity contract injected."""
    prompt = identity_preamble() + "\nQuestion: " + question.strip()
    ws = "runtime/claude_cage/active/%s" % jid
    out_rel = "%s/output/claude_response.txt" % ws
    core = {
        "job_id": jid, "task_id": "dash_" + jid, "ross_instruction": question.strip()[:400],
        "wren_interpretation": "CHAT_ONLY via dashboard broker; identity contract injected; claude -p; no tools/MCP/writes beyond job output dir.",
        "risk_level": "LOW_READ_ONLY", "assigned_worker": "claude_runner", "mode": "CHAT_ONLY",
        "job_workspace": ws, "permitted_paths": [ws], "watch_paths": ["runtime/claude_cage/active"],
        "forbidden_paths": ["CLAUDE.md", "config/wren_governor_policy.yaml",
                            "tools/qsb_governor_verifier.py", "tools/qsb_claude_job_runner.py"],
        "identity_contract_hash": (sha(IDENTITY_FILE) or "")[:16],
        "worker_steps": [{"label": "claude hq identity chat (no tools)", "class": "claude_chat",
                          "cmd": {"prompt": prompt[:4000], "output_path": out_rel, "timeout": 180}}],
        "verifier_checks": [["--check", "file", "--file", out_rel]],
        "timeout": 300, "approving_actor": "ross",
        "policy_checksum": sha(POLICY), "verifier_checksum": sha(VERIFIER),
    }
    core["packet_hash"] = hashlib.sha256(json.dumps(core, sort_keys=True).encode()).hexdigest()
    return core, out_rel


def run_cage(jid, question):
    """Write packet -> start cage unit -> wait -> read response + verifier from journal."""
    packet, out_rel = build_packet(jid, question)
    inbox = CAGE / "inbox" / ("%s.json" % jid)
    inbox.write_text(json.dumps(packet, indent=2))
    # clear any stale active dir for a clean run (root-owned -> needs sudo)
    pw = _sudo()
    subprocess.run(["sudo", "-S", "rm", "-rf", str(CAGE / "active" / jid)],
                   input=pw + "\n", capture_output=True, text=True, timeout=20)
    start = subprocess.run(["sudo", "-S", "systemctl", "start", CLAUDE_UNIT % jid],
                           input=pw + "\n", capture_output=True, text=True, timeout=240)
    # unit is oneshot; is-active returns after it finishes. Give it a moment.
    for _ in range(120):
        act = subprocess.run(["systemctl", "is-active", CLAUDE_UNIT % jid],
                             capture_output=True, text=True, timeout=5).stdout.strip()
        if act not in ("active", "activating"):
            break
        time.sleep(1)
    result = subprocess.run(["systemctl", "show", "-p", "Result", "--value", CLAUDE_UNIT % jid],
                            capture_output=True, text=True, timeout=5).stdout.strip()
    # runner prints its JSON summary to journald
    jout = subprocess.run(["sudo", "-S", "journalctl", "-u", CLAUDE_UNIT % jid, "--no-pager",
                           "-o", "cat", "--since", "3 minutes ago"],
                          input=pw + "\n", capture_output=True, text=True, timeout=15).stdout
    summary = {}
    m = re.search(r"\{[\s\S]*\"job_id\"[\s\S]*\}\s*$", jout.strip())
    if not m:
        # take the largest {...} block
        blocks = re.findall(r"\{[\s\S]*?\n\}", jout)
        if blocks:
            try:
                summary = json.loads(blocks[-1])
            except Exception:
                summary = {}
    else:
        try:
            summary = json.loads(m.group(0))
        except Exception:
            summary = {}
    resp = subprocess.run(["sudo", "-S", "cat", str(ROOT / out_rel)],
                          input=pw + "\n", capture_output=True, text=True, timeout=10).stdout.strip()
    caged_left = "1"                                     # settle-poll: claude may leave a detached node child briefly
    for _ in range(30):
        caged_left = subprocess.run(["ps", "-u", "claude_runner", "--no-headers"],
                                    capture_output=True, text=True, timeout=5).stdout.strip()
        caged_left = str(len([l for l in caged_left.splitlines() if l.strip()]))
        if caged_left == "0":
            break
        time.sleep(1)
    wr = (summary.get("worker_results") or [{}])[0]
    vr = (summary.get("verifier_results") or [{}])[0]
    return {"packet_hash": packet["packet_hash"][:16], "unit_result": result,
            "final_state": summary.get("final_state"), "response": resp,
            "response_chars": wr.get("response_chars"), "returncode": wr.get("returncode"),
            "auth": wr.get("auth"), "api_key_present": wr.get("api_key_present"),
            "verifier_result": vr.get("result"), "out_of_scope": summary.get("out_of_scope"),
            "forbidden": summary.get("forbidden"), "cage_closed": caged_left == "0",
            "caged_procs_final": caged_left, "unit_inactive": True,
            "identity_contract_hash": packet["identity_contract_hash"]}


def wren_review(question, job):
    """Canonical Wren scopes/reviews the chat request (local qwen, read-only)."""
    task = ("Governor review of a CHAT_ONLY request for the caged Claude HQ. Ross asks: %r. "
            "It will run inside the OS cage with tools+MCP disabled, subscription OAuth, no API key, "
            "output confined to the job dir, verified by a deterministic check, and cannot be self-accepted. "
            "Give a one-line scope note and a verdict from {CLAIM_VERIFIED, CLAIM_PARTIAL, CLAIM_UNSUPPORTED, "
            "OUT_OF_SCOPE_CHANGE, MANUAL_ROSS_TEST_REQUIRED} for whether this is safe to run chat-only." % question)
    try:
        out = subprocess.run(["python3", str(ROOT / "tools/qsb_wren_local_agent.py"), "--task", task],
                             capture_output=True, text=True, timeout=90, cwd=str(ROOT)).stdout
        # strip the box chrome
        lines = [l for l in out.splitlines() if l.strip() and not l.strip().startswith(("━", "session", "turns"))]
        note = " ".join(lines).strip()[:400]
        vd = next((v for v in ("CLAIM_VERIFIED", "CLAIM_PARTIAL", "CLAIM_UNSUPPORTED",
                               "OUT_OF_SCOPE_CHANGE", "MANUAL_ROSS_TEST_REQUIRED") if v in out), "CLAIM_PARTIAL")
        return note or "Wren reviewed.", vd
    except Exception as e:
        return "Wren offline: %s" % e, "MANUAL_ROSS_TEST_REQUIRED"


# ================= HTTP =================
class H(BaseHTTPRequestHandler):
    def log_message(self, *a):
        pass

    def _send(self, code, body, ctype="application/json"):
        b = body.encode() if isinstance(body, str) else body
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(b)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(b)

    def _json(self, obj, code=200):
        self._send(code, json.dumps(obj))

    def _body(self):
        n = int(self.headers.get("Content-Length", 0) or 0)
        if not n:
            return {}
        try:
            return json.loads(self.rfile.read(n).decode())
        except Exception:
            return {}

    def do_GET(self):
        p = self.path.split("?")[0]
        if p == "/" or p == "/index.html":
            return self._send(200, PAGE, "text/html; charset=utf-8")
        if p == "/health":
            return self._json({"ok": True, "service": "claude_hq_dashboard_v1", "ts": utc(),
                               "bind": BIND_ADDR, "staging_port": True, "production_8850": "untouched"})
        api = {
            "/api/claude-hq/identity": probe_identity,
            "/api/claude-hq/status": lambda: {"cage": cage_status(), "gene_pool": probe_gene_pool(),
                                              "governor_level": 1, "provider": "CLAUDE_MAX_CAGE_OAUTH",
                                              "authentication": "SUBSCRIPTION_OAUTH", "ts": utc()},
            "/api/claude-hq/cage": cage_status,
            "/api/claude-hq/tasks": probe_tasks,
            "/api/claude-hq/reports": probe_reports,
            "/api/claude-hq/evidence": probe_evidence,
            "/api/claude-hq/team": probe_team,
            "/api/claude-hq/conversation": lambda: convo_tail(),
            "/api/claude-hq/past-present-future": past_present_future,
            "/api/claude-hq/claim-evidence": claim_vs_evidence,
            "/api/claude-hq/jobs": load_jobs,
        }
        if p in api:
            try:
                return self._json(api[p]())
            except Exception as e:
                return self._json({"error": str(e)}, 500)
        return self._json({"error": "not found"}, 404)

    def do_POST(self):
        p = self.path.split("?")[0]
        b = self._body()
        jobs = load_jobs()

        if p == "/api/claude-hq/draft":
            q = str(b.get("question", "")).strip()
            if not q:
                return self._json({"error": "empty question"}, 400)
            jid = "chat_%d" % int(time.time())
            jobs[jid] = {"job_id": jid, "question": q, "state": "DRAFT", "created": utc(),
                         "wren_verdict": None, "response": None}
            save_jobs(jobs)
            convo_append("ross", q)
            return self._json({"ok": True, "job": jobs[jid], "event": "drafted"})

        jid = str(b.get("job", ""))
        if p not in ("/api/claude-hq/prepare-ross-review",) and jid and not JOB_RX.match(jid):
            return self._json({"error": "bad job id"}, 400)
        job = jobs.get(jid)

        if p == "/api/claude-hq/send-to-wren":
            if not job:
                return self._json({"error": "no such job"}, 404)
            note, vd = wren_review(job["question"], jid)
            job.update({"state": "WREN_REVIEWED", "wren_note": note, "wren_verdict": vd})
            save_jobs(jobs)
            return self._json({"ok": True, "wren_note": note, "wren_verdict": vd, "job": job})

        if p == "/api/claude-hq/approve-chat":
            if not job:
                return self._json({"error": "no such job"}, 404)
            if job.get("state") != "WREN_REVIEWED":
                return self._json({"error": "must be Wren-reviewed before Ross approval"}, 409)
            job.update({"state": "ROSS_APPROVED", "approving_actor": "ross", "approved_ts": utc()})
            save_jobs(jobs)
            return self._json({"ok": True, "job": job, "event": "ross_approved"})

        if p == "/api/claude-hq/start-approved-job":
            if not job:
                return self._json({"error": "no such job"}, 404)
            if job.get("state") != "ROSS_APPROVED":
                return self._json({"error": "job not Ross-approved"}, 409)
            job["state"] = "RUNNING"
            save_jobs(jobs)
            res = run_cage(jid, job["question"])
            job.update({"state": res.get("final_state") or "READY_FOR_ROSS", **res})
            save_jobs(jobs)
            if res.get("response"):
                convo_append("claude_hq", res["response"])
            return self._json({"ok": bool(res.get("response")), "result": res, "job": job})

        if p == "/api/claude-hq/freeze":
            if job:
                subprocess.run(["sudo", "-S", "systemctl", "stop", CLAUDE_UNIT % jid],
                               input=_sudo() + "\n", capture_output=True, text=True, timeout=30)
                job["state"] = "FROZEN"
                save_jobs(jobs)
            return self._json({"ok": True, "job": job})

        if p == "/api/claude-hq/stop":
            if job:
                subprocess.run(["sudo", "-S", "systemctl", "stop", CLAUDE_UNIT % jid],
                               input=_sudo() + "\n", capture_output=True, text=True, timeout=30)
                job["state"] = "STOPPED"
                save_jobs(jobs)
            return self._json({"ok": True, "job": job})

        if p == "/api/claude-hq/request-evidence":
            if job:
                job["evidence_requested"] = utc()
                save_jobs(jobs)
            return self._json({"ok": True, "job": job})

        if p == "/api/claude-hq/reject":
            if job:
                job["state"] = "REJECTED"
                job["reject_reason"] = str(b.get("reason", ""))[:200]
                save_jobs(jobs)
            return self._json({"ok": True, "job": job})

