def cage_status():
    """LOCKED (no job) / IDLE (job dir but no active unit) / RUNNING / FROZEN."""
    jobs = load_jobs()
    running = None
    for jid in list(jobs.keys()):
        if not JOB_RX.match(jid):
            continue
        try:
            act = subprocess.run(["systemctl", "is-active", CLAUDE_UNIT % jid],
                                 capture_output=True, text=True, timeout=5).stdout.strip()
        except Exception:
            act = "unknown"
        if act == "active" or act == "activating":
            running = jid
    frozen = [j for j, v in jobs.items() if v.get("state") == "FROZEN"]
    if running:
        state = "RUNNING"
    elif frozen:
        state = "FROZEN"
    elif jobs:
        state = "IDLE"
    else:
        state = "LOCKED"
    # no persistent caged child?
    try:
        n = subprocess.run(["bash", "-lc", "ps -u claude_runner --no-headers 2>/dev/null | wc -l"],
                           capture_output=True, text=True, timeout=5).stdout.strip()
    except Exception:
        n = "?"
    return {"state": state, "running_job": running, "frozen_jobs": frozen,
            "caged_procs": n, "live_tower_write_access": False, "level2_activated": False}


