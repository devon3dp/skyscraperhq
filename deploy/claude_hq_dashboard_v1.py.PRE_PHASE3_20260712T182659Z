def utc():
    return datetime.now(timezone.utc).isoformat().replace("+00:00", "Z")


def sha(p):
    try:
        return hashlib.sha256(Path(p).read_bytes()).hexdigest()
    except Exception:
        return None


def read_yaml(p):
    """Tiny, dependency-free flat + one-level-nest/list YAML reader for the identity contract."""
    d, cur_key = {}, None
    try:
        for raw in Path(p).read_text().splitlines():
            if not raw.strip() or raw.lstrip().startswith("#"):
                continue
            indent = len(raw) - len(raw.lstrip(" "))
            s = raw.strip()
            if indent > 0 and s.startswith("- "):                       # nested list item
                if not isinstance(d.get(cur_key), list):
                    d[cur_key] = []
                d[cur_key].append(s[2:].strip().strip('"'))
                continue
            if indent > 0 and ":" in s:                                 # nested map key
                k, v = s.split(":", 1)
                if not isinstance(d.get(cur_key), dict):
                    d[cur_key] = {}
                d[cur_key][k.strip()] = v.strip().strip('"')
                continue
            if indent == 0 and ":" in raw:                              # top-level key
                k, v = raw.split(":", 1)
                cur_key = k.strip()
                d[cur_key] = v.strip().strip('"') if v.strip() else None
    except Exception as e:
        return {"_error": str(e)}
    return d


