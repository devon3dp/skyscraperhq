[Unit]
Description=QSB On-Topic Guard + Reputation Re-Router (advisory watcher over room.jsonl)
After=network.target

[Service]
Type=oneshot
WorkingDirectory=/vaults/nvme0/qsb_tower_v1
ExecStart=/usr/bin/python3 /vaults/nvme0/qsb_tower_v1/tools/qsb_ontopic_guard.py --watch
Nice=10
# advisory only: reads room.jsonl + reputation, writes only its own audit + cursor
