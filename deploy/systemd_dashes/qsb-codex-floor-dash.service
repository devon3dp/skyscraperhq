[Unit]
Description=QSB Codex Floor Dashboard (:8870, terminal)
After=network.target
[Service]
Type=simple
User=ross
WorkingDirectory=/vaults/nvme0/qsb_tower_v1
ExecStart=/usr/bin/python3 /vaults/nvme0/qsb_tower_v1/tools/qsb_codex_floor_dash.py --port 8870
Restart=always
RestartSec=5
[Install]
WantedBy=multi-user.target
