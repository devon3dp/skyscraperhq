[Unit]
Description=QSB Tower Continuous Self-Audit (read-only probes -> council board + findings log)
After=network.target

[Service]
Type=oneshot
User=ross
WorkingDirectory=/vaults/nvme0/qsb_tower_v1
ExecStart=/usr/bin/python3 /vaults/nvme0/qsb_tower_v1/tools/qsb_self_audit.py
# Read-only + queue-only: this unit NEVER fixes/restarts anything.
Nice=10

[Install]
WantedBy=multi-user.target
