[Unit]
Description=QSB Bill Worker (Bill does real work on his Mac -> live Underground trains; non-self-verifying, honest)
After=network-online.target qsb-leadership-relay.service

[Service]
Type=oneshot
User=ross
WorkingDirectory=/vaults/nvme0/qsb_tower_v1
ExecStart=/usr/bin/python3 /vaults/nvme0/qsb_tower_v1/tools/qsb_bill_worker.py
