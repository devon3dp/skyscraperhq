[Unit]
Description=QSB Bill Concierge Tick (lease-respecting tower-status heartbeat via relay :8855)
After=network.target qsb-leadership-relay.service

[Service]
Type=oneshot
User=ross
WorkingDirectory=/vaults/nvme0/qsb_tower_v1
Environment=BILL_RELAY=http://127.0.0.1:8855
ExecStart=/usr/bin/python3 /vaults/nvme0/qsb_tower_v1/tools/qsb_bill_agent.py --heartbeat

[Install]
WantedBy=multi-user.target
