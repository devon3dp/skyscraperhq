[Unit]
Description=QSB Agentic Traders Live Dashboard (:8863, read-only)
After=network.target qsb-event-bus.service
[Service]
Type=simple
User=ross
WorkingDirectory=/vaults/nvme0/qsb_tower_v1
ExecStart=/usr/bin/python3 /vaults/nvme0/qsb_tower_v1/tools/qsb_agentic_traders_dash.py --port 8863
Restart=always
RestartSec=5
[Install]
WantedBy=multi-user.target
