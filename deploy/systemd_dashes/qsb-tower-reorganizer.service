[Unit]
Description=QSB Tower Reorganizer (:8872, guided live-apply)
After=network.target
[Service]
Type=simple
User=ross
WorkingDirectory=/vaults/nvme0/qsb_tower_v1
ExecStart=/usr/bin/python3 /vaults/nvme0/qsb_tower_v1/tools/qsb_tower_reorganizer.py --port 8872
Restart=always
RestartSec=5
[Install]
WantedBy=multi-user.target
