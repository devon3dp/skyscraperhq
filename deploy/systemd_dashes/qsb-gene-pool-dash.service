[Unit]
Description=QSB Gene Pool Dashboard (:8873)
After=network.target
[Service]
Type=simple
User=ross
WorkingDirectory=/vaults/nvme0/qsb_tower_v1
ExecStart=/usr/bin/python3 /vaults/nvme0/qsb_tower_v1/tools/qsb_gene_pool_dash.py --port 8873
Restart=always
RestartSec=5
[Install]
WantedBy=multi-user.target
