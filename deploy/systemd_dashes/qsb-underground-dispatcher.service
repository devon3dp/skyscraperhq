[Unit]
Description=QSB Underground Dispatcher (real events across every valid tube track — providers, comms, council, codex)
After=network.target qsb-leadership-relay.service qsb-transit-map.service
Wants=qsb-leadership-relay.service

[Service]
Type=oneshot
User=ross
WorkingDirectory=/vaults/nvme0/qsb_tower_v1
ExecStart=/usr/bin/python3 /vaults/nvme0/qsb_tower_v1/tools/qsb_underground_dispatcher.py --once
TimeoutStartSec=300
