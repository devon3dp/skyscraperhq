[Unit]
Description=QSB Task Council Live Dashboard (:8864, read-only, storyline+progress)
After=network.target qsb-task-council-autorunner.service
[Service]
Type=simple
User=ross
WorkingDirectory=/vaults/nvme0/qsb_tower_v1
ExecStart=/usr/bin/python3 /vaults/nvme0/qsb_tower_v1/tools/qsb_council_live_dash.py --port 8864
Restart=always
RestartSec=5
[Install]
WantedBy=multi-user.target
