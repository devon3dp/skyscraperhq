[Unit]
Description=QSB Floor 53 Tower Command (:8874)
After=network.target
[Service]
Type=simple
User=ross
WorkingDirectory=/vaults/nvme0/qsb_tower_v1
ExecStart=/usr/bin/python3 /vaults/nvme0/qsb_tower_v1/tools/qsb_floor53_command_dash.py --port 8874
Restart=always
RestartSec=5
[Install]
WantedBy=multi-user.target
