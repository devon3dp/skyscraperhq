[Unit]
Description=QSB CEO Task Worker (makes tp_pip/acer_cass/bill task-driven — real minds, non-self-verifying, kill-switchable)
After=network.target qsb-task-council-autorunner.service qsb-leadership-relay.service

[Service]
Type=oneshot
User=ross
WorkingDirectory=/vaults/nvme0/qsb_tower_v1
Environment=CEO_WORKER_PER_CAP=1
Environment=BILL_WAIT_S=300
ExecStart=/usr/bin/python3 /vaults/nvme0/qsb_tower_v1/tools/qsb_ceo_task_worker.py --once

[Install]
WantedBy=multi-user.target
