[Unit]
Description=QSB Proposal-Advance — sandbox queued proposals + surface green ones ready-for-signature (NEVER signs, NEVER applies)
After=network.target

[Service]
Type=oneshot
User=ross
WorkingDirectory=/vaults/nvme0/qsb_tower_v1
# --limit keeps each pass bounded; the timer fires every ~2-3min so the whole
# queue drains over several passes. It sandboxes + records verdicts only.
# The >=3 unique-class multi-sig + Ross gate stays entirely with humans.
ExecStart=/usr/bin/python3 /vaults/nvme0/qsb_tower_v1/tools/qsb_proposal_advance.py --limit 25

[Install]
WantedBy=multi-user.target
