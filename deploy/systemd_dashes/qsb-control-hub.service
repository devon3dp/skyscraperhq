[Unit]
Description=QSB SkyscraperHQ Control landing hub (:8888)
After=qsb-boardroom.service network-online.target
Wants=network-online.target
[Service]
Type=simple
User=ross
WorkingDirectory=/vaults/nvme0/qsb_tower_v1
ExecStart=/usr/bin/python3 /vaults/nvme0/qsb_tower_v1/tools/qsb_control_hub.py --port 8888
Restart=always
RestartSec=5
[Install]
WantedBy=multi-user.target
