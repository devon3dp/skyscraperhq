# QSB Receptionist kiosk config — Pass 2 (2026-07-10)
# Ross may edit HQ_HOST if the tower moves to a different network/IP.
#
# Chosen 2026-07-10: tower is on the iPhone hotspot (172.20.10.x).
# NOTE: 172.20.10.2 is a DHCP lease and CAN change when the hotspot
# reassigns addresses. If the dashboard shows the "unreachable" fallback,
# check the tower's current IP (on the tower run:  hostname -I ) and set
# HQ_HOST below, then reboot the Pi or run:  systemctl restart qsb-reception-kiosk
HQ_HOST=172.20.10.2

# Dashboard ports (tower side)
BOARDROOM_PORT=8852
GENEPOOL_PORT=8860
WREN_PORT=8851

# Kiosk start order (first reachable wins); falls back to local HTML.
KIOSK_URLS="http://172.20.10.2:8852/ http://172.20.10.2:8852/tasks http://172.20.10.2:8860/"
