[Unit]
Description=QSB Tower sign-off audit — track closed vs open work

[Service]
Type=oneshot
WorkingDirectory=/vaults/nvme0/qsb_tower_v1
Environment=PATH=/vaults/nvme0/qsb_tower_v1/.venv/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/vaults/nvme0/qsb_tower_v1/.venv/bin/python3 /vaults/nvme0/qsb_tower_v1/tools/qsb_signoff_audit.py
StandardOutput=append:/vaults/nvme0/qsb_tower_v1/logs/qsb_signoff_audit.log
StandardError=append:/vaults/nvme0/qsb_tower_v1/logs/qsb_signoff_audit.log

[Install]
WantedBy=default.target
