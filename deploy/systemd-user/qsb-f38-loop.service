[Unit]
Description=QSB Tower Floor 38 — Sandbox Operations loop
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/qsb_tower_v1
Environment=PATH=%h/qsb_tower_v1/.venv/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/qsb_tower_v1/.venv/bin/python3 %h/qsb_tower_v1/tools/qsb_f38_sandbox_ops_loop.py
Restart=always
RestartSec=10
StandardOutput=append:%h/qsb_tower_v1/logs/qsb_f38_loop.log
StandardError=append:%h/qsb_tower_v1/logs/qsb_f38_loop.log

[Install]
WantedBy=default.target
