[Unit]
Description=QSB Tower dashboard server — FastAPI on :8765
After=network-online.target
PartOf=qsb-tower-heartbeat.service

[Service]
Type=simple
WorkingDirectory=%h/qsb_tower_v1
Environment=PATH=%h/qsb_tower_v1/.venv/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/qsb_tower_v1/.venv/bin/python3 %h/qsb_tower_v1/src/dashboard/server.py
Restart=always
RestartSec=10
StandardOutput=append:%h/qsb_tower_v1/logs/qsb_dashboard.log
StandardError=append:%h/qsb_tower_v1/logs/qsb_dashboard.log

[Install]
WantedBy=default.target
