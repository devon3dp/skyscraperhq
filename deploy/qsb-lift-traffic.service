[Unit]
Description=QSB Lift Traffic (inter-zone information highways: emits ONE lift-traffic row per REAL sourced info movement — worker needs deliveries, delivered chain reports, leadership comms — along the real lift shaft whose serves includes both endpoint floors; R01 honest, append-only to the shared map feed; topology/visualization only, executes nothing, flips no gate)
After=network.target qsb-worker-needs-queue.service qsb-chain-reporting.service qsb-leadership-relay.service
[Service]
Type=oneshot
User=ross
WorkingDirectory=/vaults/nvme0/qsb_tower_v1
ExecStart=/vaults/nvme0/qsb_tower_v1/.venv/bin/python3 /vaults/nvme0/qsb_tower_v1/tools/qsb_lift_traffic.py --max 40
Nice=10
[Install]
WantedBy=multi-user.target
